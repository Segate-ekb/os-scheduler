#Использовать "../"
#Использовать asserts

// Тесты расписаний: интервал, однократно, ежедневно, вычисление следующего
// момента. Чистые юнит-тесты без часов и исполнителя — работают с датами напрямую.

&Тест
Процедура ИнтервалСчитаетСледующийОтОпоры() Экспорт

	Расписание = Расписания.Интервал(60);
	Опора = Дата(2026, 1, 1, 12, 0, 0);

	// первый запуск — через интервал после опоры (момента регистрации)
	Ожидаем.Что(Расписание.СледующийМомент(Опора, Ложь)).Равно(Опора + 60);
	// последующий — через интервал после предыдущего запуска
	Ожидаем.Что(Расписание.СледующийМомент(Опора + 60, Истина)).Равно(Опора + 120);

КонецПроцедуры

&Тест
Процедура ИнтервалТребуетПоложительногоЗначения() Экспорт

	ПроверитьИсключение("Расписания.Интервал(0)");
	ПроверитьИсключение("Расписания.Интервал(-5)");
	ПроверитьИсключение("Расписания.Интервал(""минута"")");

КонецПроцедуры

&Тест
Процедура ОднократноСрабатываетОдинРазСЗадержкой() Экспорт

	Расписание = Расписания.Однократно(10);
	Опора = Дата(2026, 1, 1, 12, 0, 0);

	// единственный запуск — через задержку после регистрации
	Ожидаем.Что(Расписание.СледующийМомент(Опора, Ложь)).Равно(Опора + 10);
	// после того как запуск был — больше не запускается
	Ожидаем.Что(Расписание.СледующийМомент(Опора + 10, Истина)).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОднократноБезЗадержкиСрабатываетНемедленно() Экспорт

	Расписание = Расписания.Однократно();
	Опора = Дата(2026, 1, 1, 12, 0, 0);
	Ожидаем.Что(Расписание.СледующийМомент(Опора, Ложь)).Равно(Опора);

КонецПроцедуры

&Тест
Процедура ЕжедневноБерётБлижайшееВремяСуток() Экспорт

	Расписание = Расписания.ЕжедневноВ(3, 30);

	// опора до 03:30 того же дня — запуск сегодня в 03:30
	Опора1 = Дата(2026, 1, 1, 1, 0, 0);
	Ожидаем.Что(Расписание.СледующийМомент(Опора1, Ложь)).Равно(Дата(2026, 1, 1, 3, 30, 0));

	// опора после 03:30 — запуск завтра в 03:30
	Опора2 = Дата(2026, 1, 1, 4, 0, 0);
	Ожидаем.Что(Расписание.СледующийМомент(Опора2, Ложь)).Равно(Дата(2026, 1, 2, 3, 30, 0));

	// опора ровно в 03:30 — время уже наступило, следующий запуск завтра
	Опора3 = Дата(2026, 1, 1, 3, 30, 0);
	Ожидаем.Что(Расписание.СледующийМомент(Опора3, Истина)).Равно(Дата(2026, 1, 2, 3, 30, 0));

КонецПроцедуры

&Тест
Процедура ЕжедневноПроверяетДиапазоны() Экспорт

	ПроверитьИсключение("Расписания.ЕжедневноВ(24)");
	ПроверитьИсключение("Расписания.ЕжедневноВ(-1)");
	ПроверитьИсключение("Расписания.ЕжедневноВ(10, 60)");
	ПроверитьИсключение("Расписания.ЕжедневноВ(10, 0, 60)");

КонецПроцедуры

// --- Служебные ---

Процедура ПроверитьИсключение(Знач Выражение)
	БылоИсключение = Ложь;
	Попытка
		Результат = Вычислить(Выражение);
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение, "Ожидалось исключение для: " + Выражение).ЭтоИстина();
КонецПроцедуры

// Фикстура: дескриптор выполнения приложения — реализует утиный контракт
// (Завершено, ЗавершеноУспешно, ТекстОшибки), но НЕ является классом библиотеки.
// Нужен, чтобы проверить: планировщик принимает чужой дескриптор.

Перем Завершено_;
Перем Успех_;
Перем Ошибка_;

Процедура ПриСозданииОбъекта()
	Завершено_ = Ложь;
	Успех_ = Ложь;
	Ошибка_ = Неопределено;
КонецПроцедуры

Функция Завершено() Экспорт
	Возврат Завершено_;
КонецФункции

Функция ЗавершеноУспешно() Экспорт
	Возврат Успех_;
КонецФункции

Функция ТекстОшибки() Экспорт
	Возврат Ошибка_;
КонецФункции

// Завершает дескриптор (в бою это делает фоновый поток приложения).
Процедура Завершить(Знач Успех, Знач Ошибка = Неопределено) Экспорт
	Завершено_ = Истина;
	Успех_ = Успех;
	Ошибка_ = Ошибка;
КонецПроцедуры

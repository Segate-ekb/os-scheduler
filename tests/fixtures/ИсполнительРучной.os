// Фикстура: исполнитель с ручным управлением завершением — имитирует долгие
// (асинхронные) задачи без реальных потоков. Возвращает НЕЗАВЕРШЁННЫЙ дескриптор,
// который завершает сам тест, поэтому проверки перекрытия и грациозной остановки
// полностью детерминированы.

Перем Выполнения_;      // Массив выданных дескрипторов Выполнение
Перем ВызововЗапуска_;  // Число фактических диспетчеризаций

Процедура ПриСозданииОбъекта()
	Выполнения_ = Новый Массив;
	ВызововЗапуска_ = 0;
КонецПроцедуры

Функция Запустить(Знач Обработчик) Экспорт
	ВызововЗапуска_ = ВызововЗапуска_ + 1;
	Попытка
		Обработчик.Исполнить(); // сторонний эффект (счётчик), исключение изолируем
	Исключение
		// в тестах перекрытия/остановки обработчики не бросают
	КонецПопытки;
	Выполнение = Новый Выполнение;
	Выполнения_.Добавить(Выполнение);
	Возврат Выполнение;
КонецФункции

// Сколько раз планировщик реально запустил задачу.
Функция ВызововЗапуска() Экспорт
	Возврат ВызововЗапуска_;
КонецФункции

Функция ПоследнееВыполнение() Экспорт
	Возврат Выполнения_[Выполнения_.ВГраница()];
КонецФункции

Процедура ЗавершитьВсеУспехом() Экспорт
	Для Каждого Выполнение Из Выполнения_ Цикл
		Если НЕ Выполнение.Завершено() Тогда
			Выполнение.ЗавершитьУспехом();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

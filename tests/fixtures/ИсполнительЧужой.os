// Фикстура: исполнитель приложения, который возвращает СВОЙ дескриптор
// (ДескрипторЧужой), а не класс библиотеки — так выглядит асинхронный исполнитель,
// написанный приложением. Дескриптор выдаётся незавершённым, завершает его тест
// (ЗавершитьВсеУспехом), поэтому проверки детерминированы.

Перем Дескрипторы_;

Процедура ПриСозданииОбъекта()
	Дескрипторы_ = Новый Массив;
КонецПроцедуры

Функция Запустить(Знач Обработчик) Экспорт

	Дескриптор = НовыйДескриптор();
	Дескрипторы_.Добавить(Дескриптор);

	Попытка
		Обработчик.Исполнить();
	Исключение
		Дескриптор.Завершить(Ложь, ОписаниеОшибки()); // изоляция исключения обработчика
	КонецПопытки;

	Возврат Дескриптор;

КонецФункции

Процедура ЗавершитьВсеУспехом() Экспорт
	Для Каждого Дескриптор Из Дескрипторы_ Цикл
		Если НЕ Дескриптор.Завершено() Тогда
			Дескриптор.Завершить(Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НовыйДескриптор()
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ЗагрузитьСценарий(ОбъединитьПути(Файл.Путь, "ДескрипторЧужой.os"));
КонецФункции

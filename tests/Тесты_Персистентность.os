#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты персистентности состояния через абстракцию хранилища: состояние задачи
// переживает пересоздание планировщика (имитация рестарта процесса), обработчик
// при этом задаётся в коде заново.

&Тест
Процедура СостояниеЗадачиПереживаетПересозданиеПланировщика() Экспорт

	База = Дата(2026, 1, 1, 12, 0, 0);
	Хранилище = Новый ХранилищеЗадачВПамяти; // общее для обоих планировщиков

	// --- Сессия 1: задача отработала дважды ---
	Часы1 = НовыеЧасы(База);
	Планировщик1 = НовыйПланировщик(Хранилище, Часы1);
	Планировщик1.Зарегистрировать("job", Расписания.Интервал(60), НовыйСчётчик());
	Планировщик1.Запустить();

	Часы1.Прибавить(60);
	Планировщик1.Тик();
	Часы1.Прибавить(60);
	Планировщик1.Тик();

	Ожидаем.Что(Планировщик1.Состояние("job").запусковВсего).Равно(2);

	// --- Сессия 2: новый планировщик поверх того же хранилища ---
	Часы2 = НовыеЧасы(База + 200);
	Планировщик2 = НовыйПланировщик(Хранилище, Часы2);
	ОбработчикНовый = НовыйСчётчик(); // обработчик задаётся в коде заново
	Планировщик2.Зарегистрировать("job", Расписания.Интервал(60), ОбработчикНовый);

	Состояние = Планировщик2.Состояние("job");
	// счётчики и отметки времени восстановлены из хранилища
	Ожидаем.Что(Состояние.запусковВсего).Равно(2);
	Ожидаем.Что(Состояние.успехов).Равно(2);
	Ожидаем.Что(Состояние.последнийЗапуск).Равно(База + 120);
	Ожидаем.Что(Состояние.следующийЗапуск).Равно(База + 180);
	// а обработчик — свежий, ещё не вызывался
	Ожидаем.Что(ОбработчикНовый.Счётчик()).Равно(0);

	// --- Продолжение работы во второй сессии ---
	Планировщик2.Запустить();
	Планировщик2.Тик(); // текущее время База+200 > СледующийЗапуск База+180 → запуск
	Ожидаем.Что(ОбработчикНовый.Счётчик()).Равно(1);
	Ожидаем.Что(Планировщик2.Состояние("job").запусковВсего).Равно(3);

КонецПроцедуры

&Тест
Процедура ПовисшийСтатусВыполненияСбрасываетсяПриВосстановлении() Экспорт

	Хранилище = Новый ХранилищеЗадачВПамяти;
	// имитируем аварийно сохранённое состояние «выполняется»
	Снимок = Новый Структура(
		"последнийЗапуск,следующийЗапуск,статус,ошибка,выполняется,оставшихсяПовторов,запусковВсего,успехов,ошибок",
		Дата(2026, 1, 1, 12, 0, 0), Дата(2026, 1, 1, 12, 1, 0), "выполняется", Неопределено, Истина, 0, 1, 0, 0);
	Хранилище.СохранитьСостояние("job", Снимок);

	Планировщик = НовыйПланировщик(Хранилище, НовыеЧасы());
	Планировщик.Зарегистрировать("job", Расписания.Интервал(60), НовыйСчётчик());

	Состояние = Планировщик.Состояние("job");
	Ожидаем.Что(Состояние.выполняется).ЭтоЛожь();   // в свежем процессе ничего не идёт
	Ожидаем.Что(Состояние.статус).Равно("ожидает"); // «повисший» статус нормализован

КонецПроцедуры

&Тест
Процедура НеполныйСнимокНеРоняетРегистрациюИДаётЧистыйСтарт() Экспорт

	// Неполный снимок (дрейф схемы БД / частичная запись) не бросает
	// необработанное исключение при регистрации — задача стартует с чистого состояния.
	База = Дата(2026, 1, 1, 12, 0, 0);
	Хранилище = Новый ХранилищеЗадачВПамяти;
	Хранилище.СохранитьСостояние("job", Новый Структура("статус", "успех")); // не хватает ключей

	Планировщик = НовыйПланировщик(Хранилище, НовыеЧасы(База));
	// не должно бросить исключение
	Планировщик.Зарегистрировать("job", Расписания.Интервал(60), НовыйСчётчик());

	Состояние = Планировщик.Состояние("job");
	Ожидаем.Что(Состояние.статус).Равно("ожидает");        // чистое состояние
	Ожидаем.Что(Состояние.запусковВсего).Равно(0);
	Ожидаем.Что(Состояние.последнийЗапуск).Равно(Неопределено);
	Ожидаем.Что(Состояние.следующийЗапуск).Равно(База + 60); // вычислен заново от текущего времени

КонецПроцедуры

&Тест
Процедура СнимокСНекорректнымиТипамиОтвергается() Экспорт

	// Снимок со всеми ключами, но с битым типом значения (счётчик — строкой) —
	// тоже отвергается, регистрация не падает, старт чистый.
	База = Дата(2026, 1, 1, 12, 0, 0);
	Хранилище = Новый ХранилищеЗадачВПамяти;
	БитыйСнимок = Новый Структура(
		"последнийЗапуск,следующийЗапуск,статус,ошибка,выполняется,оставшихсяПовторов,запусковВсего,успехов,ошибок",
		Неопределено, Неопределено, "ожидает", Неопределено, Ложь, 0, "НЕ-ЧИСЛО", 0, 0);
	Хранилище.СохранитьСостояние("job", БитыйСнимок);

	Планировщик = НовыйПланировщик(Хранилище, НовыеЧасы(База));
	Планировщик.Зарегистрировать("job", Расписания.Интервал(60), НовыйСчётчик());

	Ожидаем.Что(Планировщик.Состояние("job").запусковВсего).Равно(0); // битый снимок проигнорирован

КонецПроцедуры

&Тест
Процедура СнимокПерезаписываетсяЧистымПослеОтклонения() Экспорт

	// После отклонения битого снимка планировщик самовосстанавливает хранилище:
	// в нём оказывается валидный снимок чистого состояния.
	Хранилище = Новый ХранилищеЗадачВПамяти;
	Хранилище.СохранитьСостояние("job", Новый Структура("мусор", 1));

	Планировщик = НовыйПланировщик(Хранилище, НовыеЧасы());
	Планировщик.Зарегистрировать("job", Расписания.Интервал(60), НовыйСчётчик());

	Снимок = Хранилище.ПрочитатьСостояние("job");
	Ожидаем.Что(Снимок.Свойство("запусковВсего")).ЭтоИстина(); // снимок теперь валиден
	Ожидаем.Что(Снимок.запусковВсего).Равно(0);

КонецПроцедуры

// --- Служебные ---

Функция НовыйПланировщик(Знач Хранилище, Знач Часы)
	Возврат Новый Планировщик(Новый Структура("Хранилище, Часы", Хранилище, Часы));
КонецФункции

Функция НовыеЧасы(Знач Момент = Неопределено)
	Часы = ЗагрузитьСценарий(ПутьФикстуры("ЧасыРучные.os"));
	Если Момент <> Неопределено Тогда
		Часы.УстановитьМомент(Момент);
	КонецЕсли;
	Возврат Часы;
КонецФункции

Функция НовыйСчётчик()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("ОбработчикСчётчик.os"));
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции

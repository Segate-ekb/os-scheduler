#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты планировщика: регистрация, диспетчеризация по расписанию, изоляция
// ошибок, повтор при ошибке, контракт исполнителя. Синхронный исполнитель по
// умолчанию, время — управляемые часы из фикстуры (без реального Sleep).

&Тест
Процедура РегистрацияВычисляетПервыйЗапуск() Экспорт

	Окружение = НовоеОкружение();

	Окружение.Планировщик.Зарегистрировать("прогрев", Расписания.Интервал(60), НовыйСчётчик());

	Состояние = Окружение.Планировщик.Состояние("прогрев");
	Ожидаем.Что(Состояние).ЭтоНе().Равно(Неопределено);
	Ожидаем.Что(Состояние.имя).Равно("прогрев");
	Ожидаем.Что(Состояние.следующийЗапуск).Равно(Окружение.Часы.Сейчас() + 60);
	Ожидаем.Что(Состояние.статус).Равно("ожидает");

КонецПроцедуры

&Тест
Процедура ПовторнаяРегистрацияВызываетИсключение() Экспорт

	Окружение = НовоеОкружение();
	Окружение.Планировщик.Зарегистрировать("a", Расписания.Интервал(60), НовыйСчётчик());

	БылоИсключение = Ложь;
	Попытка
		Окружение.Планировщик.Зарегистрировать("a", Расписания.Интервал(60), НовыйСчётчик());
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение, "Ожидалось исключение при дубликате имени").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТикЗапускаетЗадачуКогдаНаступилМомент() Экспорт

	Окружение = НовоеОкружение();
	Обработчик = НовыйСчётчик();
	Окружение.Планировщик.Зарегистрировать("тик", Расписания.Интервал(60), Обработчик);
	Окружение.Планировщик.Запустить();

	// ещё рано — задача не запускается
	Окружение.Часы.Прибавить(59);
	Ожидаем.Что(Окружение.Планировщик.Тик()).Равно(0);
	Ожидаем.Что(Обработчик.Счётчик()).Равно(0);

	// момент наступил — запуск, синхронно завершается успехом в этом же тике
	Окружение.Часы.Прибавить(1);
	Ожидаем.Что(Окружение.Планировщик.Тик()).Равно(1);
	Ожидаем.Что(Обработчик.Счётчик()).Равно(1);

	Состояние = Окружение.Планировщик.Состояние("тик");
	Ожидаем.Что(Состояние.статус).Равно("успех");
	Ожидаем.Что(Состояние.выполняется).ЭтоЛожь();
	Ожидаем.Что(Состояние.следующийЗапуск).Равно(Окружение.Часы.Сейчас() + 60);

КонецПроцедуры

&Тест
Процедура ИнтервалЗапускаетсяМногократно() Экспорт

	Окружение = НовоеОкружение();
	Обработчик = НовыйСчётчик();
	Окружение.Планировщик.Зарегистрировать("цикл", Расписания.Интервал(10), Обработчик);
	Окружение.Планировщик.Запустить();

	Для Номер = 1 По 5 Цикл
		Окружение.Часы.Прибавить(10);
		Окружение.Планировщик.Тик();
	КонецЦикла;

	Ожидаем.Что(Обработчик.Счётчик()).Равно(5);
	Ожидаем.Что(Окружение.Планировщик.Состояние("цикл").запусковВсего).Равно(5);
	Ожидаем.Что(Окружение.Планировщик.Состояние("цикл").успехов).Равно(5);

КонецПроцедуры

&Тест
Процедура ОднократнаяЗадачаНеПовторяется() Экспорт

	Окружение = НовоеОкружение();
	Обработчик = НовыйСчётчик();
	Окружение.Планировщик.Зарегистрировать("однократно", Расписания.Однократно(5), Обработчик);
	Окружение.Планировщик.Запустить();

	Окружение.Часы.Прибавить(5);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Обработчик.Счётчик()).Равно(1);

	// сколько бы ни прошло времени — повторов нет
	Окружение.Часы.Прибавить(1000);
	Окружение.Планировщик.Тик();
	Окружение.Часы.Прибавить(1000);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Обработчик.Счётчик()).Равно(1);
	Ожидаем.Что(Окружение.Планировщик.Состояние("однократно").следующийЗапуск).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СостоянияОтдаютСнимкиВсехЗадач() Экспорт

	Окружение = НовоеОкружение();
	Окружение.Планировщик.Зарегистрировать("первая", Расписания.Интервал(10), НовыйСчётчик());
	Окружение.Планировщик.Зарегистрировать("вторая", Расписания.Интервал(20), НовыйСчётчик());

	Состояния = Окружение.Планировщик.Состояния();
	Ожидаем.Что(Состояния.Количество()).Равно(2);
	Ожидаем.Что(Состояния.Получить("первая").следующийЗапуск).Равно(Окружение.Часы.Сейчас() + 10);
	Ожидаем.Что(Состояния.Получить("вторая").следующийЗапуск).Равно(Окружение.Часы.Сейчас() + 20);

	// снимок — копия: правка не доходит до планировщика
	Снимок = Состояния.Получить("первая");
	Снимок.статус = "выдумка";
	Ожидаем.Что(Окружение.Планировщик.Состояние("первая").статус).Равно("ожидает");

	// незарегистрированная задача — Неопределено, а не исключение
	Ожидаем.Что(Окружение.Планировщик.Состояние("нет-такой")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПадениеЗадачиНеРоняетПланировщикИДругиеЗадачи() Экспорт

	Окружение = НовоеОкружение();
	Падающий = НовыйПадающий();
	Хороший = НовыйСчётчик();
	Окружение.Планировщик.Зарегистрировать("падает", Расписания.Интервал(10), Падающий);
	Окружение.Планировщик.Зарегистрировать("работает", Расписания.Интервал(10), Хороший);
	Окружение.Планировщик.Запустить();

	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик(); // не должно бросить исключение наружу

	// планировщик жив, соседняя задача отработала
	Ожидаем.Что(Окружение.Планировщик.Запущен()).ЭтоИстина();
	Ожидаем.Что(Хороший.Счётчик()).Равно(1);
	Ожидаем.Что(Окружение.Планировщик.Состояние("работает").статус).Равно("успех");

	// у упавшей задачи зафиксирована ошибка
	Упавшая = Окружение.Планировщик.Состояние("падает");
	Ожидаем.Что(Упавшая.статус).Равно("ошибка");
	Ожидаем.Что(Упавшая.ошибка).ЭтоНе().Равно(Неопределено);
	Ожидаем.Что(Упавшая.ошибок).Равно(1);

	// следующий цикл продолжает работать для обеих
	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Хороший.Счётчик()).Равно(2);
	Ожидаем.Что(Окружение.Планировщик.Состояние("падает").ошибок).Равно(2);

КонецПроцедуры

&Тест
Процедура ПовторПриОшибкеСоблюдаетЗадержкуИЛимит() Экспорт

	Окружение = НовоеОкружение();
	Падающий = НовыйПадающий();
	// интервал 100, до 2 повторов с задержкой 5 секунд
	Окружение.Планировщик.Зарегистрировать("повтор", Расписания.Интервал(100), Падающий,
		Новый Структура("МаксПовторов, ЗадержкаПовтораСекунд", 2, 5));
	Окружение.Планировщик.Запустить();

	// первый запуск по расписанию → ошибка, запланирован повтор через 5 с
	Окружение.Часы.Прибавить(100);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Падающий.Попыток()).Равно(1);
	Ожидаем.Что(Окружение.Планировщик.Состояние("повтор").следующийЗапуск).Равно(Окружение.Часы.Сейчас() + 5);

	// повтор 1 через 5 с → снова ошибка, ещё один повтор
	Окружение.Часы.Прибавить(5);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Падающий.Попыток()).Равно(2);
	Ожидаем.Что(Окружение.Планировщик.Состояние("повтор").следующийЗапуск).Равно(Окружение.Часы.Сейчас() + 5);

	// повтор 2 через 5 с → ошибка, лимит исчерпан → возврат к обычному расписанию
	Окружение.Часы.Прибавить(5);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Падающий.Попыток()).Равно(3);
	Ожидаем.Что(Окружение.Планировщик.Состояние("повтор").следующийЗапуск).Равно(Окружение.Часы.Сейчас() + 100);
	Ожидаем.Что(Окружение.Планировщик.Состояние("повтор").ошибок).Равно(3);

КонецПроцедуры

&Тест
Процедура БюджетПовторовВосстанавливаетсяКаждыйПлановыйЦикл() Экспорт

	// Регрессия: задача, падающая ВСЕГДА, обязана повторяться в КАЖДОМ плановом
	// цикле (а не только в первом). Интервал 100, до 2 повторов с задержкой 5.
	Окружение = НовоеОкружение();
	Падающий = НовыйПадающий();
	Окружение.Планировщик.Зарегистрировать("ночной-джоб", Расписания.Интервал(100), Падающий,
		Новый Структура("МаксПовторов, ЗадержкаПовтораСекунд", 2, 5));
	Окружение.Планировщик.Запустить();

	// --- Цикл 1: плановый запуск + 2 повтора = 3 попытки ---
	Окружение.Часы.Прибавить(100); Окружение.Планировщик.Тик(); // плановый (t=100)
	Окружение.Часы.Прибавить(5);   Окружение.Планировщик.Тик(); // повтор 1 (t=105)
	Окружение.Часы.Прибавить(5);   Окружение.Планировщик.Тик(); // повтор 2 (t=110)
	Ожидаем.Что(Падающий.Попыток()).Равно(3);
	// после исчерпания — обычный слот (следующий плановый цикл)
	Ожидаем.Что(Окружение.Планировщик.Состояние("ночной-джоб").следующийЗапуск)
		.Равно(Окружение.Часы.Сейчас() + 100); // t=210

	// --- Цикл 2: бюджет повторов снова полный → ещё 3 попытки ---
	Окружение.Часы.Прибавить(100); Окружение.Планировщик.Тик(); // плановый (t=210)
	Окружение.Часы.Прибавить(5);   Окружение.Планировщик.Тик(); // повтор 1 (t=215)
	Окружение.Часы.Прибавить(5);   Окружение.Планировщик.Тик(); // повтор 2 (t=220)
	Ожидаем.Что(Падающий.Попыток()).Равно(6); // 3 + 3, а НЕ 4

	Ожидаем.Что(Окружение.Планировщик.Состояние("ночной-джоб").ошибок).Равно(6);

КонецПроцедуры

&Тест
Процедура СбойИсполнителяИзолируетсяИдётЧерезПовторыБезИнкрементаЗапусков() Экспорт

	// Сбой самого исполнителя фиксируется как ошибка, идёт через логику повторов,
	// но ЗапусковВсего не растёт (обработчик не стартовал).
	Часы = НовыеЧасы();
	Планировщик = НовыйПланировщик(ЗагрузитьСценарий(ПутьФикстуры("ИсполнительСбойный.os")), Часы);
	Планировщик.Зарегистрировать("job", Расписания.Интервал(100), НовыйСчётчик(),
		Новый Структура("МаксПовторов, ЗадержкаПовтораСекунд", 1, 5));
	Планировщик.Запустить();

	Часы.Прибавить(100);
	Планировщик.Тик(); // не должно бросить исключение наружу

	Ожидаем.Что(Планировщик.Запущен()).ЭтоИстина();
	Состояние = Планировщик.Состояние("job");
	Ожидаем.Что(Состояние.статус).Равно("ошибка");
	Ожидаем.Что(Состояние.запусковВсего).Равно(0); // обработчик не стартовал
	Ожидаем.Что(Состояние.ошибок).Равно(1);
	// повтор запланирован через задержку (единое поведение с падением обработчика)
	Ожидаем.Что(Состояние.следующийЗапуск).Равно(Часы.Сейчас() + 5);
	Ожидаем.Что(Планировщик.Активных()).Равно(0);

КонецПроцедуры

&Тест
Процедура ИсполнительВернувшийНеДескрипторНеПодвешиваетЗадачу() Экспорт

	// Исполнитель нарушил контракт (вернул Неопределено) — гвард ловит,
	// задача не виснет в активных, фиксируется ошибка контракта.
	Часы = НовыеЧасы();
	Планировщик = НовыйПланировщик(ЗагрузитьСценарий(ПутьФикстуры("ИсполнительПустой.os")), Часы);
	Планировщик.Зарегистрировать("job", Расписания.Интервал(100), НовыйСчётчик());
	Планировщик.Запустить();

	Часы.Прибавить(100);
	Планировщик.Тик();

	Ожидаем.Что(Планировщик.Активных()).Равно(0); // не подвисла
	Состояние = Планировщик.Состояние("job");
	Ожидаем.Что(Состояние.выполняется).ЭтоЛожь();
	Ожидаем.Что(Состояние.статус).Равно("ошибка");
	Ожидаем.Что(Состояние.ошибка).Содержит("контракт");

КонецПроцедуры

&Тест
Процедура ЧужойДескрипторПринимаетсяПоУтиномуКонтракту() Экспорт

	// Исполнитель приложения возвращает СВОЙ дескриптор (не класс библиотеки):
	// планировщик проверяет контракт по методам, а не по типу.
	Часы = НовыеЧасы();
	Исполнитель = ЗагрузитьСценарий(ПутьФикстуры("ИсполнительЧужой.os"));
	Планировщик = НовыйПланировщик(Исполнитель, Часы);
	Обработчик = НовыйСчётчик();
	Планировщик.Зарегистрировать("job", Расписания.Интервал(10), Обработчик);
	Планировщик.Запустить();

	// дескриптор выдан незавершённым — задача считается идущей
	Часы.Прибавить(10);
	Планировщик.Тик();
	Ожидаем.Что(Обработчик.Счётчик()).Равно(1);
	Ожидаем.Что(Планировщик.Активных()).Равно(1);
	Ожидаем.Что(Планировщик.Состояние("job").статус).Равно("выполняется");

	// приложение завершило выполнение → ближайший тик финализирует задачу
	Исполнитель.ЗавершитьВсеУспехом();
	Планировщик.Тик();
	Ожидаем.Что(Планировщик.Активных()).Равно(0);
	Ожидаем.Что(Планировщик.Состояние("job").статус).Равно("успех");
	Ожидаем.Что(Планировщик.Состояние("job").успехов).Равно(1);

КонецПроцедуры

// --- Служебные ---

Функция НовоеОкружение()
	Часы = НовыеЧасы();
	Хранилище = Новый ХранилищеЗадачВПамяти;
	Планировщик = Новый Планировщик(Новый Структура("Хранилище, Исполнитель, Часы",
		Хранилище, Новый ИсполнительСинхронный, Часы));
	Возврат Новый Структура("Планировщик, Хранилище, Часы", Планировщик, Хранилище, Часы);
КонецФункции

Функция НовыйПланировщик(Знач Исполнитель, Знач Часы)
	Возврат Новый Планировщик(Новый Структура("Исполнитель, Часы", Исполнитель, Часы));
КонецФункции

Функция НовыеЧасы()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("ЧасыРучные.os"));
КонецФункции

Функция НовыйСчётчик()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("ОбработчикСчётчик.os"));
КонецФункции

Функция НовыйПадающий()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("ОбработчикПадающий.os"));
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции

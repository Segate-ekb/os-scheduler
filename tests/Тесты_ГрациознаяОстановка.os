#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты остановки планировщика на ручном исполнителе:
//   * грациозная (по умолчанию) — новые задачи не запускаются, но идущие
//     финализируются в Тик() (дождаться текущих);
//   * отменяющая — идущие задачи помечаются «остановлена» немедленно.

&Тест
Процедура ГрациознаяОстановкаДожидаетсяТекущегоИНеЗапускаетНовые() Экспорт

	Окружение = НовоеОкружение();
	Окружение.Планировщик.Зарегистрировать("долгая", Расписания.Интервал(10), НовыйСчётчик());
	Окружение.Планировщик.Зарегистрировать("другая", Расписания.Интервал(10), НовыйСчётчик());
	Окружение.Планировщик.Запустить();

	// t+10: обе стартуют, обе «идут» (ручной исполнитель не завершает)
	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Планировщик.Активных()).Равно(2);

	// грациозная остановка: возвращает число ещё активных
	Ожидаем.Что(Окружение.Планировщик.Остановить()).Равно(2);
	Ожидаем.Что(Окружение.Планировщик.Запущен()).ЭтоЛожь();

	// прошло много времени и был тик — новые запуски НЕ происходят
	Окружение.Часы.Прибавить(1000);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Исполнитель.ВызововЗапуска()).Равно(2); // всё те же два старта

	// текущие выполнения завершаются, тик их финализирует → активных не осталось
	Окружение.Исполнитель.ЗавершитьВсеУспехом();
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Планировщик.Активных()).Равно(0);
	Ожидаем.Что(Окружение.Планировщик.Состояние("долгая").статус).Равно("успех");
	Ожидаем.Что(Окружение.Планировщик.Состояние("другая").статус).Равно("успех");

КонецПроцедуры

&Тест
Процедура ОтменяющаяОстановкаПомечаетИдущиеОстановленными() Экспорт

	Окружение = НовоеОкружение();
	Окружение.Планировщик.Зарегистрировать("долгая", Расписания.Интервал(10), НовыйСчётчик());
	Окружение.Планировщик.Запустить();

	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Планировщик.Активных()).Равно(1);

	// отменяющая остановка: активных не остаётся немедленно
	Ожидаем.Что(Окружение.Планировщик.Остановить(Истина)).Равно(0);
	Состояние = Окружение.Планировщик.Состояние("долгая");
	Ожидаем.Что(Состояние.статус).Равно("остановлена");
	Ожидаем.Что(Состояние.выполняется).ЭтоЛожь();

КонецПроцедуры

// --- Служебные ---

Функция НовоеОкружение()
	Часы = ЗагрузитьСценарий(ПутьФикстуры("ЧасыРучные.os"));
	Исполнитель = ЗагрузитьСценарий(ПутьФикстуры("ИсполнительРучной.os"));
	Планировщик = Новый Планировщик(Новый Структура("Исполнитель, Часы", Исполнитель, Часы));
	Возврат Новый Структура("Планировщик, Часы, Исполнитель", Планировщик, Часы, Исполнитель);
КонецФункции

Функция НовыйСчётчик()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("ОбработчикСчётчик.os"));
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции

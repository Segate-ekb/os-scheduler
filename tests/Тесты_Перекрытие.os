#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Тесты политик перекрытия на ручном исполнителе (ИсполнительРучной): долгая
// задача не завершается, пока тест не завершит её дескриптор — это позволяет
// детерминированно смоделировать «очередной запуск наступил, а предыдущий идёт».

&Тест
Процедура ПропуститьНеЗапускаетЗадачуПоверхСебя() Экспорт

	Окружение = НовоеОкружение();
	// политика по умолчанию — "пропустить"
	Окружение.Планировщик.Зарегистрировать("долгая", Расписания.Интервал(10), НовыйСчётчик());
	Окружение.Планировщик.Запустить();

	// t+10: запуск, выполнение остаётся идти (ручной исполнитель не завершает)
	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Исполнитель.ВызововЗапуска()).Равно(1);
	Ожидаем.Что(Окружение.Планировщик.Состояние("долгая").выполняется).ЭтоИстина();

	// t+20: снова «пора», но предыдущее ещё идёт → пропуск, повторного запуска нет
	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Исполнитель.ВызововЗапуска()).Равно(1);

	// завершаем текущее выполнение и доводим часы до следующего слота
	Окружение.Исполнитель.ЗавершитьВсеУспехом();
	Окружение.Часы.Прибавить(10); // t+30
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Исполнитель.ВызововЗапуска()).Равно(2);

КонецПроцедуры

&Тест
Процедура ОчередьЗапускаетОдинОтложенныйПослеЗавершения() Экспорт

	Окружение = НовоеОкружение();
	Окружение.Планировщик.Зарегистрировать("очередь", Расписания.Интервал(10), НовыйСчётчик(),
		Новый Структура("ПолитикаПерекрытия", "очередь"));
	Окружение.Планировщик.Запустить();

	// t+10: первый запуск, идёт
	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Исполнитель.ВызововЗапуска()).Равно(1);

	// t+20 и t+30: пока идёт первое — наступали ещё два срабатывания,
	// но очередь глубины 1: копится только один отложенный запуск
	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик();
	Окружение.Часы.Прибавить(10);
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Исполнитель.ВызововЗапуска()).Равно(1);

	// завершаем первое выполнение → следующий тик запускает отложенное (ровно одно)
	Окружение.Исполнитель.ЗавершитьВсеУспехом();
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Исполнитель.ВызововЗапуска()).Равно(2);

	// завершаем и его → больше отложенных нет
	Окружение.Исполнитель.ЗавершитьВсеУспехом();
	Окружение.Планировщик.Тик();
	Ожидаем.Что(Окружение.Исполнитель.ВызововЗапуска()).Равно(2);

КонецПроцедуры

&Тест
Процедура НедопустимаяПолитикаПерекрытияОтвергаетсяПриРегистрации() Экспорт

	Окружение = НовоеОкружение();

	БылоИсключение = Ложь;
	Попытка
		Окружение.Планировщик.Зарегистрировать("кривая", Расписания.Интервал(10), НовыйСчётчик(),
			Новый Структура("ПолитикаПерекрытия", "ждать"));
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение, "Ожидалось исключение при недопустимой политике").ЭтоИстина();
	Ожидаем.Что(Окружение.Планировщик.Состояние("кривая")).Равно(Неопределено);

КонецПроцедуры

// --- Служебные ---

Функция НовоеОкружение()
	Часы = ЗагрузитьСценарий(ПутьФикстуры("ЧасыРучные.os"));
	Хранилище = Новый ХранилищеЗадачВПамяти;
	Исполнитель = ЗагрузитьСценарий(ПутьФикстуры("ИсполнительРучной.os"));
	Планировщик = Новый Планировщик(Новый Структура("Хранилище, Исполнитель, Часы",
		Хранилище, Исполнитель, Часы));
	Возврат Новый Структура("Планировщик, Хранилище, Часы, Исполнитель",
		Планировщик, Хранилище, Часы, Исполнитель);
КонецФункции

Функция НовыйСчётчик()
	Возврат ЗагрузитьСценарий(ПутьФикстуры("ОбработчикСчётчик.os"));
КонецФункции

Функция ПутьФикстуры(Знач Имя)
	Файл = Новый Файл(ТекущийСценарий().Источник);
	Возврат ОбъединитьПути(Файл.Путь, "fixtures", Имя);
КонецФункции

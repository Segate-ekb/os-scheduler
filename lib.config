<?xml version="1.0" encoding="utf-8"?>
<!-- Публичный интерфейс библиотеки — один класс и одна фабрика расписаний.
     Всё остальное лежит в src/internal, подключается изнутри директивой
     #Использовать "../internal" и меняется без оглядки на обратную совместимость. -->
<package-def xmlns="http://oscript.io/schemas/lib-config/1.0">
    <class name="Планировщик" file="src/Классы/Планировщик.os"/>
    <module name="Расписания" file="src/Модули/Расписания.os"/>
</package-def>

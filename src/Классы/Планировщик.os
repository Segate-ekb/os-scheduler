// Реестр задач и диспетчер их запуска — единственный класс, с которым работает
// приложение. Задача, расписание, исполнитель и хранилище живут в src/internal и
// наружу не выдаются: наружу выдаются снимки состояния (плоские Структуры).
//
// Модель работы — опросная, без потоков и без Sleep внутри библиотеки: Тик()
// делает один шаг (финализирует завершившиеся выполнения, затем запускает
// созревшие задачи), а реальный цикл организует приложение. Отсюда полная
// детерминированность на инъектируемых часах.
//
// Все зависимости — утиные контракты с реализацией по умолчанию: хранилище
// состояния (в памяти), исполнитель (синхронный), часы (системные). См. README.

#Использовать "../internal"

Перем Хранилище_;
Перем Исполнитель_;
Перем Часы_;

Перем Задачи_;             // Соответствие: имя → Задача
Перем АктивныеВыполнения_; // Соответствие: имя → дескриптор выполнения (идущие сейчас)
Перем ОтложенныеЗапуски_;  // Соответствие: имя → Истина (очередь глубины 1)
Перем Запущен_;            // Булево

#Область ПрограммныйИнтерфейс

// Параметры:
//   Настройки - Структура, Соответствие - необязательные Хранилище, Исполнитель,
//               Часы; незаданное берётся по умолчанию.
//
Процедура ПриСозданииОбъекта(Знач Настройки = Неопределено)

	Хранилище_ = Поле(Настройки, "Хранилище", Новый ХранилищеЗадачВПамяти);
	Исполнитель_ = Поле(Настройки, "Исполнитель", Новый ИсполнительСинхронный);
	Часы_ = Поле(Настройки, "Часы", Новый ЧасыСистемные);

	Задачи_ = Новый Соответствие;
	АктивныеВыполнения_ = Новый Соответствие;
	ОтложенныеЗапуски_ = Новый Соответствие;
	Запущен_ = Ложь;

КонецПроцедуры

// Регистрирует задачу: восстанавливает её состояние из хранилища (переживает
// рестарт процесса) и вычисляет момент первого запуска. Дубликат имени — исключение.
//
// Параметры:
//   Имя        - Строка - уникальное имя задачи (ключ в планировщике и хранилище);
//   Расписание - Расписание - результат Расписания.Интервал/Однократно/ЕжедневноВ
//                либо свой объект с методом СледующийМомент(Опора, БылЗапуск);
//   Обработчик - Произвольный - объект с методом Исполнить();
//   Настройки  - Структура, Соответствие - необязательные ПолитикаПерекрытия
//                ("пропустить" | "очередь"), МаксПовторов, ЗадержкаПовтораСекунд.
//
Процедура Зарегистрировать(Знач Имя, Знач Расписание, Знач Обработчик, Знач Настройки = Неопределено) Экспорт

	Если Задачи_.Получить(Имя) <> Неопределено Тогда
		ВызватьИсключение "Задача уже зарегистрирована: " + Имя;
	КонецЕсли;

	НоваяЗадача = Новый Задача(Имя, Расписание, Обработчик,
		Поле(Настройки, "ПолитикаПерекрытия", "пропустить"),
		Поле(Настройки, "МаксПовторов", 0),
		Поле(Настройки, "ЗадержкаПовтораСекунд", 0));

	// Повреждённый снимок не валит регистрацию: задача стартует с чистого
	// состояния, факт логируется (Сообщить — родной вывод без внешнего логгера).
	Снимок = Хранилище_.ПрочитатьСостояние(Имя);
	Если Снимок <> Неопределено И НЕ НоваяЗадача.ВосстановитьСостояние(Снимок) Тогда
		Сообщить("os-scheduler: повреждённое сохранённое состояние задачи """
			+ Имя + """ — регистрируется с чистого состояния");
	КонецЕсли;

	Если НоваяЗадача.СледующийЗапуск() = Неопределено Тогда
		БылЗапуск = НоваяЗадача.ПоследнийЗапуск() <> Неопределено;
		Опора = ?(БылЗапуск, НоваяЗадача.ПоследнийЗапуск(), Часы_.Сейчас());
		НоваяЗадача.УстановитьСледующийЗапуск(Расписание.СледующийМомент(Опора, БылЗапуск));
	КонецЕсли;

	Задачи_.Вставить(Имя, НоваяЗадача);
	СохранитьСостояние(НоваяЗадача);

КонецПроцедуры

// Снимок состояния задачи — копия, менять её безопасно (состав полей в README).
//
// Возвращаемое значение:
//   Структура, Неопределено - Неопределено, если задача не зарегистрирована.
//
Функция Состояние(Знач Имя) Экспорт

	Задача = Задачи_.Получить(Имя);
	Возврат ?(Задача = Неопределено, Неопределено, Снимок(Задача));

КонецФункции

// Соответствие «имя → снимок состояния» по всем зарегистрированным задачам.
Функция Состояния() Экспорт

	Результат = Новый Соответствие;
	Для Каждого Запись Из Задачи_ Цикл
		Результат.Вставить(Запись.Ключ, Снимок(Запись.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Разрешает диспетчеризацию: последующие Тик() будут запускать задачи.
Процедура Запустить() Экспорт
	Запущен_ = Истина;
КонецПроцедуры

Функция Запущен() Экспорт
	Возврат Запущен_;
КонецФункции

// Количество идущих сейчас выполнений.
Функция Активных() Экспорт
	Возврат АктивныеВыполнения_.Количество();
КонецФункции

// Один шаг планировщика. Завершившиеся выполнения финализируются ВСЕГДА (в т.ч.
// после грациозной остановки — чтобы дождаться текущих), новые задачи
// запускаются только когда планировщик запущен.
//
// Возвращаемое значение:
//   Число - количество задач, запущенных в этом тике.
//
Функция Тик() Экспорт

	Сейчас = Часы_.Сейчас();

	Для Каждого Имя Из КлючиАктивных() Цикл
		ПопытатьсяФинализировать(Имя, Сейчас);
	КонецЦикла;

	Если НЕ Запущен_ Тогда
		Возврат 0;
	КонецЕсли;

	Запущено = 0;
	Для Каждого Запись Из Задачи_ Цикл
		Если ЗапуститьЕслиПора(Запись.Значение, Сейчас) Тогда
			Запущено = Запущено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Запущено;

КонецФункции

// Останавливает планировщик.
//
// Библиотека не может прервать чужой поток исполнителя, поэтому «жёсткая»
// остановка лишь помечает идущие задачи как «остановлена» и отпускает их
// дескрипторы; фактическое прерывание работы — на стороне исполнителя.
//
// Параметры:
//   Отменять - Булево - Ложь (по умолчанию): грациозно — новые задачи не
//              запускаются, но идущие продолжают финализироваться в Тик()
//              (вызывайте Тик() до Активных() = 0);
//              Истина: отменяюще — идущие задачи помечаются «остановлена».
//
// Возвращаемое значение:
//   Число - количество ещё активных выполнений после остановки.
//
Функция Остановить(Знач Отменять = Ложь) Экспорт

	Запущен_ = Ложь;

	Если Отменять Тогда
		Для Каждого Имя Из КлючиАктивных() Цикл
			Задача = Задачи_.Получить(Имя);
			Задача.ОтметитьОстановлена();
			АктивныеВыполнения_.Удалить(Имя);
			ОтложенныеЗапуски_.Удалить(Имя);
			СохранитьСостояние(Задача);
		КонецЦикла;
	КонецЕсли;

	Возврат Активных();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запускает задачу, если наступил её момент; обрабатывает перекрытие.
// Возвращает Истина, если задача была фактически запущена в этом вызове.
Функция ЗапуститьЕслиПора(Знач Задача, Знач Сейчас)

	Момент = Задача.СледующийЗапуск();
	Пора = (Момент <> Неопределено) И (Момент <= Сейчас);

	Если Задача.Выполняется() Тогда
		Если Пора Тогда
			Если Задача.ПолитикаПерекрытия() = "очередь" Тогда
				ОтложенныеЗапуски_.Вставить(Задача.Имя(), Истина); // один отложенный запуск
			КонецЕсли;
			// И для "очередь", и для "пропустить" переносим слот вперёд,
			// чтобы не срабатывать на каждом тике, пока задача занята.
			Задача.УстановитьСледующийЗапуск(Задача.Расписание().СледующийМомент(Сейчас, Истина));
			СохранитьСостояние(Задача);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	Если НЕ Пора Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗапуститьЗадачу(Задача, Сейчас);
	Возврат Истина;

КонецФункции

Процедура ЗапуститьЗадачу(Знач Задача, Знач Сейчас)

	// Начало нового планового (не-повторного) цикла — восстанавливаем бюджет,
	// чтобы каждый цикл получал свои МаксПовторов попыток.
	Если НЕ Задача.СледующийЗапускПовтор() Тогда
		Задача.ВосстановитьБюджетПовторов();
	КонецЕсли;

	Выполнение = Неопределено;
	СбойИсполнителя = Ложь;
	ТекстСбоя = "";
	Попытка
		Выполнение = Исполнитель_.Запустить(Задача.Обработчик());
	Исключение
		СбойИсполнителя = Истина;
		ТекстСбоя = ОписаниеОшибки();
	КонецПопытки;

	Если СбойИсполнителя Тогда
		// Обработчик НЕ стартовал — ЗапусковВсего не растёт, но ошибка фиксируется
		// и повтор планируется так же, как при падении обработчика.
		ЗафиксироватьОшибку(Задача, Сейчас, "Сбой исполнителя: " + ТекстСбоя);
		СохранитьСостояние(Задача);
		Возврат;
	КонецЕсли;

	Если НЕ ДескрипторКорректен(Выполнение) Тогда
		// Без гварда задача зависла бы в активных навсегда.
		ЗафиксироватьОшибку(Задача, Сейчас,
			"Исполнитель нарушил контракт: Запустить() обязан вернуть дескриптор выполнения"
			+ " (Завершено, ЗавершеноУспешно, ТекстОшибки)");
		СохранитьСостояние(Задача);
		Возврат;
	КонецЕсли;

	Задача.ОтметитьСтарт(Сейчас);
	Задача.УстановитьСледующийЗапуск(Задача.Расписание().СледующийМомент(Сейчас, Истина));
	АктивныеВыполнения_.Вставить(Задача.Имя(), Выполнение);
	СохранитьСостояние(Задача);

	// Синхронный исполнитель уже отработал — финализируем сразу, чтобы задача
	// в этом же тике получила статус успех/ошибка.
	ПопытатьсяФинализировать(Задача.Имя(), Сейчас);

КонецПроцедуры

Процедура ПопытатьсяФинализировать(Знач Имя, Знач Сейчас)

	Выполнение = АктивныеВыполнения_.Получить(Имя);
	Если Выполнение = Неопределено ИЛИ НЕ Выполнение.Завершено() Тогда
		Возврат;
	КонецЕсли;

	Задача = Задачи_.Получить(Имя);
	АктивныеВыполнения_.Удалить(Имя);

	Если Выполнение.ЗавершеноУспешно() Тогда
		Задача.ОтметитьУспех();
		ЗапланироватьОтложенный(Имя, Задача, Сейчас);
	Иначе
		ЗафиксироватьОшибку(Задача, Сейчас, Выполнение.ТекстОшибки());
	КонецЕсли;

	СохранитьСостояние(Задача);

КонецПроцедуры

// Общий путь для падения обработчика и сбоя исполнителя: повтор с задержкой,
// пока остались попытки, иначе обычный слот расписания.
Процедура ЗафиксироватьОшибку(Знач Задача, Знач Сейчас, Знач Текст)

	Задача.ОтметитьОшибку(Текст);
	Если Задача.ЕстьПовтор() Тогда
		Задача.УменьшитьПовтор();
		Задача.УстановитьСледующийЗапуск(Сейчас + Задача.ЗадержкаПовтораСекунд(), Истина);
		ОтложенныеЗапуски_.Удалить(Задача.Имя());
	Иначе
		Задача.УстановитьСледующийЗапуск(Задача.Расписание().СледующийМомент(Сейчас, Истина));
		ЗапланироватьОтложенный(Задача.Имя(), Задача, Сейчас);
	КонецЕсли;

КонецПроцедуры

// Если для задачи стоял отложенный запуск (политика "очередь") — запускаем немедленно.
Процедура ЗапланироватьОтложенный(Знач Имя, Знач Задача, Знач Сейчас)
	Если ОтложенныеЗапуски_.Получить(Имя) = Истина Тогда
		ОтложенныеЗапуски_.Удалить(Имя);
		Задача.УстановитьСледующийЗапуск(Сейчас); // сработает в шаге 2 текущего/следующего тика
	КонецЕсли;
КонецПроцедуры

// Утиная проверка контракта: тип не смотрим — асинхронный исполнитель приложения
// возвращает свой дескриптор, а не класс библиотеки.
Функция ДескрипторКорректен(Знач Выполнение)

	Если Выполнение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат ТипЗнч(Выполнение.Завершено()) = Тип("Булево");
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Массив-снимок ключей активных выполнений (для безопасного изменения в цикле).
Функция КлючиАктивных()
	Ключи = Новый Массив;
	Для Каждого Запись Из АктивныеВыполнения_ Цикл
		Ключи.Добавить(Запись.Ключ);
	КонецЦикла;
	Возврат Ключи;
КонецФункции

Функция Снимок(Знач Задача)

	Результат = Новый Структура("имя", Задача.Имя());
	Для Каждого КлючЗначение Из Задача.Состояние() Цикл
		Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура СохранитьСостояние(Знач Задача)
	Хранилище_.СохранитьСостояние(Задача.Имя(), Задача.Состояние());
КонецПроцедуры

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти

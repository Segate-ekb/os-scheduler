// Дескриптор (future/handle) одного запуска задачи. Планировщик не блокируется на
// исполнителе — он опрашивает дескриптор в каждом тике, поэтому асинхронный
// исполнитель отдаёт незавершённый дескриптор и завершает его позже, из фонового
// потока. Своим исполнителям этот класс не обязателен: планировщик проверяет
// контракт утиным способом, а не по типу.

Перем Завершено_; // Булево
Перем Успех_;     // Булево
Перем Ошибка_;    // Строка | Неопределено

#Область ПрограммныйИнтерфейс

Процедура ПриСозданииОбъекта()
	Завершено_ = Ложь;
	Успех_ = Ложь;
	Ошибка_ = Неопределено;
КонецПроцедуры

Процедура ЗавершитьУспехом() Экспорт
	Завершено_ = Истина;
	Успех_ = Истина;
	Ошибка_ = Неопределено;
КонецПроцедуры

Процедура ЗавершитьОшибкой(Знач Текст) Экспорт
	Завершено_ = Истина;
	Успех_ = Ложь;
	Ошибка_ = Текст;
КонецПроцедуры

// Истина, если выполнение завершено — успешно или с ошибкой.
Функция Завершено() Экспорт
	Возврат Завершено_;
КонецФункции

Функция ЗавершеноУспешно() Экспорт
	Возврат Успех_;
КонецФункции

// Текст ошибки или Неопределено, если ошибки не было.
Функция ТекстОшибки() Экспорт
	Возврат Ошибка_;
КонецФункции

#КонецОбласти

// Правило вычисления моментов запуска задачи: интервал, однократно, ежедневно.
// Создаётся только фабрикой — публичным модулем Расписания, который и проверяет
// параметры. Контракт «объект с методом СледующийМомент(Опора, БылЗапуск)» открыт:
// своё расписание (например, cron) можно передать в планировщик, не меняя его.

Перем Тип_;            // Строка: "интервал" | "однократно" | "ежедневно"
Перем ИнтервалСекунд_; // Число
Перем ЗадержкаСекунд_; // Число
Перем Час_;            // Число 0..23
Перем Минута_;         // Число 0..59
Перем Секунда_;        // Число 0..59

#Область ПрограммныйИнтерфейс

Процедура ПриСозданииОбъекта(Знач Тип, Знач ИнтервалСекунд = 0, Знач ЗадержкаСекунд = 0,
	Знач Час = 0, Знач Минута = 0, Знач Секунда = 0)

	Тип_ = Тип;
	ИнтервалСекунд_ = ИнтервалСекунд;
	ЗадержкаСекунд_ = ЗадержкаСекунд;
	Час_ = Час;
	Минута_ = Минута;
	Секунда_ = Секунда;

КонецПроцедуры

Функция ТипРасписания() Экспорт
	Возврат Тип_;
КонецФункции

// Момент следующего запуска по опоре (момент регистрации либо момент последнего
// запуска) и признаку, был ли уже хотя бы один запуск.
//
// Возвращаемое значение:
//   Дата         - момент следующего запуска;
//   Неопределено - запусков больше не будет (однократное расписание отработало).
//
Функция СледующийМомент(Знач Опора, Знач БылЗапуск) Экспорт

	Если Тип_ = "интервал" Тогда
		Возврат Опора + ИнтервалСекунд_;

	ИначеЕсли Тип_ = "однократно" Тогда
		Если БылЗапуск Тогда
			Возврат Неопределено;
		Иначе
			Возврат Опора + ЗадержкаСекунд_;
		КонецЕсли;

	ИначеЕсли Тип_ = "ежедневно" Тогда
		Возврат СледующийЕжедневный(Опора);

	Иначе
		ВызватьИсключение "Неизвестный тип расписания: " + Тип_;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ближайший момент времени суток Час_:Минута_:Секунда_, строго больше опоры.
Функция СледующийЕжедневный(Знач Опора)

	Кандидат = НачалоДня(Опора) + Час_ * 3600 + Минута_ * 60 + Секунда_;
	Если Кандидат <= Опора Тогда
		Кандидат = Кандидат + 86400; // время сегодня уже прошло — берём завтра
	КонецЕсли;
	Возврат Кандидат;

КонецФункции

#КонецОбласти

// Исполнитель по умолчанию: выполняет обработчик немедленно, в тике планировщика,
// и возвращает уже завершённый дескриптор. Так библиотека не зависит от ОСени.
//
// КОНТРАКТ ИСПОЛНИТЕЛЯ: Запустить(Обработчик) → дескриптор выполнения (методы
// Завершено, ЗавершеноУспешно, ТекстОшибки). Исполнитель ОБЯЗАН изолировать
// исключение обработчика: падение обработчика фиксируется в дескрипторе, а не
// летит в планировщик. Асинхронный исполнитель приложения возвращает
// незавершённый дескриптор и завершает его из фонового потока.

#Область ПрограммныйИнтерфейс

Функция Запустить(Знач Обработчик) Экспорт

	Выполнение = Новый Выполнение;
	Попытка
		Обработчик.Исполнить();
		Выполнение.ЗавершитьУспехом();
	Исключение
		Выполнение.ЗавершитьОшибкой(ОписаниеОшибки());
	КонецПопытки;
	Возврат Выполнение;

КонецФункции

#КонецОбласти

// Фабрика расписаний запуска задач — единая точка их создания с проверкой
// параметров. Возвращённое расписание передаётся в Планировщик.Зарегистрировать.

#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Запуск каждые ИнтервалСекунд секунд; первый — через интервал после регистрации.
Функция Интервал(Знач ИнтервалСекунд) Экспорт

	ПроверитьЦелоеПоложительное(ИнтервалСекунд, "Интервал");
	Возврат Новый Расписание("интервал", ИнтервалСекунд);

КонецФункции

// Единственный запуск через ЗадержкаСекунд после регистрации (0 — в ближайший тик).
Функция Однократно(Знач ЗадержкаСекунд = 0) Экспорт

	ПроверитьЦелоеНеотрицательное(ЗадержкаСекунд, "Задержка");
	Возврат Новый Расписание("однократно", 0, ЗадержкаСекунд);

КонецФункции

// Запуск раз в сутки в указанное время суток — по часам планировщика.
Функция ЕжедневноВ(Знач Час, Знач Минута = 0, Знач Секунда = 0) Экспорт

	ПроверитьДиапазон(Час, 0, 23, "Час");
	ПроверитьДиапазон(Минута, 0, 59, "Минута");
	ПроверитьДиапазон(Секунда, 0, 59, "Секунда");
	Возврат Новый Расписание("ежедневно", 0, 0, Час, Минута, Секунда);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЦелоеПоложительное(Знач Значение, Знач Имя)
	Если ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение <= 0 Тогда
		ВызватьИсключение Имя + " должен быть положительным числом, получено: " + Строка(Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЦелоеНеотрицательное(Знач Значение, Знач Имя)
	Если ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение < 0 Тогда
		ВызватьИсключение Имя + " должен быть неотрицательным числом, получено: " + Строка(Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДиапазон(Знач Значение, Знач Мин, Знач Макс, Знач Имя)
	Если ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение < Мин ИЛИ Значение > Макс Тогда
		ВызватьИсключение СтрШаблон("%1 должен быть в диапазоне %2..%3, получено: %4", Имя, Мин, Макс, Значение);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
